<configs>

	<!-- ================================================================== -->
	<!-- Foxacary items                                                      -->
	<!--                                                                      -->
	<!-- Every item slots into craftingMedical progression via progression.xml. -->
	<!-- Each item uses an underused or entirely-unused vanilla resource.      -->
	<!--                                                                      -->
	<!-- Extends carries properties over, not effect groups or the use       -->
	<!-- requirements in Action0. So every item adds its own XP (see         -->
	<!-- buffFoxacaryMedicalXP), and an item that only cures something       -->
	<!-- can't be used on yourself without it, the way vanilla's bandage     -->
	<!-- and splint can't. Use on others can't be checked up front (vanilla  -->
	<!-- has the same limit), so there the XP waits for a real patient.      -->
	<!-- ================================================================== -->

	<append xpath="/items">

		<!-- =============================================================== -->
		<!-- Foxacary Field Brace                                             -->
		<!-- Cures a sprain without requiring Physician perk.                  -->
		<!-- Uses: thread (accumulates), cloth fragments, wood.                -->
		<!-- =============================================================== -->
		<item name="foxacaryFieldBrace">
			<property name="Extends" value="medicalSplint"/>
			<property name="CustomIcon" value="medicalSplint"/>
			<property name="CustomIconTint" value="c8a878"/>
			<property name="Tags" value="medical,medicalSkill,foxacary"/>
			<property name="Group" value="Science,Medical,TCMedical"/>
			<property name="UnlockedBy" value="craftingMedical"/>
			<property name="EconomicValue" value="15"/>
			<property name="Stacknumber" value="5"/>
			<property name="DescriptionKey" value="foxacaryFieldBraceDesc"/>

			<property class="Action0">
				<requirement name="HasBuff" buff="buffLegSprained,buffArmSprained"/>
			</property>

			<!-- XP before the cure, so the check on others sees the sprain -->
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP">
					<requirement name="HasBuff" target="other" buff="buffLegSprained,buffArmSprained"/></triggered_effect>
			</effect_group>

			<!-- Strip perk requirement; splint requires perkPhysician 1. -->
			<effect_group name="Primary Action" tiered="false">
				<requirement name="HasBuff" buff="buffLegSprained"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffLegSprained"/>
			</effect_group>
			<effect_group name="Primary Action" tiered="false">
				<requirement name="HasBuff" buff="buffArmSprained"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffArmSprained"/>
			</effect_group>
			<effect_group name="Secondary Action" tiered="false">
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="RemoveBuff" target="other" buff="buffLegSprained">
					<requirement name="HasBuff" target="other" buff="buffLegSprained"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="RemoveBuff" target="other" buff="buffArmSprained">
					<requirement name="HasBuff" target="other" buff="buffArmSprained"/>
				</triggered_effect>
			</effect_group>
		</item>

		<!-- =============================================================== -->
		<!-- Foxacary Suture Kit                                              -->
		<!-- Instant stop on bleeding, laceration AND abrasion in one use.     -->
		<!-- Vanilla's sewing kit already sutures a laceration, so the kit    -->
		<!-- built from one does too.                                         -->
		<!-- Uses: thread, sewing kit (accumulates), alcohol.                  -->
		<!-- =============================================================== -->
		<item name="foxacarySutureKit">
			<property name="Extends" value="medicalBandage"/>
			<property name="CustomIcon" value="medicalBandage"/>
			<property name="CustomIconTint" value="a0c0e0"/>
			<property name="DisplayType" value="foxacaryStopsBleeding"/>
			<property name="Tags" value="medical,medicalSkill,stopsBleeding,foxacary"/>
			<property name="Group" value="Science,Medical,TCMedical"/>
			<property name="UnlockedBy" value="craftingMedical"/>
			<property name="EconomicValue" value="30"/>
			<property name="Stacknumber" value="5"/>
			<property name="DescriptionKey" value="foxacarySutureKitDesc"/>

			<property class="Action0">
				<requirement name="HasBuff" buff="buffInjuryBleeding,buffLaceration,buffInjuryAbrasion"/>
			</property>

			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP">
					<requirement name="HasBuff" target="other" buff="buffInjuryBleeding,buffLaceration,buffInjuryAbrasion"/></triggered_effect>

				<triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffInjuryBleeding"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffLaceration"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffInjuryAbrasion"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="RemoveBuff" target="other" buff="buffInjuryBleeding"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="RemoveBuff" target="other" buff="buffLaceration"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="RemoveBuff" target="other" buff="buffInjuryAbrasion"/>
				<display_value name="dStopsBleeding" value="1"/>
				<display_value name="dStopsLaceration" value="1"/>
				<display_value name="dStopsAbrasion" value="1"/>
			</effect_group>
		</item>

		<!-- =============================================================== -->
		<!-- Foxacary Honeyed Battle Dressing                                 -->
		<!-- Stops bleeding, blocks catching an infection for 2 minutes, and   -->
		<!-- cures 5% of one you already have, the same as eating the honey    -->
		<!-- (honey = infection, per the Kitsune brand rule).                  -->
		<!-- Uses: honey, bandage, cloth.                                      -->
		<!-- =============================================================== -->
		<item name="foxacaryHoneyedDressing">
			<property name="Extends" value="medicalBandage"/>
			<property name="CustomIcon" value="medicalBandage"/>
			<property name="CustomIconTint" value="f4b942"/>
			<property name="DisplayType" value="foxacaryHoneyedDressing"/>
			<property name="Tags" value="medical,medicalSkill,stopsBleeding,foxacary"/>
			<property name="Group" value="Science,Medical,TCMedical"/>
			<property name="UnlockedBy" value="craftingMedical"/>
			<property name="EconomicValue" value="50"/>
			<property name="Stacknumber" value="5"/>
			<property name="DescriptionKey" value="foxacaryHoneyedDressingDesc"/>

			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP"/>

				<triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffInjuryBleeding"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffInfectionCatch"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryHoneyedDressing"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="RemoveBuff" target="other" buff="buffInjuryBleeding"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="RemoveBuff" target="other" buff="buffInfectionCatch"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" target="other" buff="buffFoxacaryHoneyedDressing"/>
				<display_value name="dStopsBleeding" value="1"/>

				<!-- Honey's own cure, as foodHoney does it -->
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$buffInfectionAddCurePerc" operation="add" value="5"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffInfectionAddCure"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyCVar" target="other" cvar="$buffInfectionAddCurePerc" operation="add" value="5"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" target="other" buff="buffInfectionAddCure"/>
				<display_value name="dCureInfection" value=".05"/>
			</effect_group>
		</item>

		<!-- =============================================================== -->
		<!-- Foxacary Royal Jelly Salve                                        -->
		<!-- Strong heal-over-time, finally gives queen bees a purpose.        -->
		<!-- Uses: queen bee (ZERO vanilla use!), beeswax, cloth.              -->
		<!-- =============================================================== -->
		<item name="foxacaryRoyalJellySalve">
			<property name="Extends" value="medicalAloeCream"/>
			<property name="CustomIcon" value="medicalAloeCream"/>
			<property name="CustomIconTint" value="ffd966"/>
			<property name="DisplayType" value="foxacaryHealOverTime"/>
			<property name="Tags" value="medical,medicalSkill,foxacary"/>
			<property name="Group" value="Science,Medical,TCMedical"/>
			<property name="UnlockedBy" value="craftingMedical"/>
			<property name="EconomicValue" value="150"/>
			<property name="Stacknumber" value="5"/>
			<property name="DescriptionKey" value="foxacaryRoyalJellySalveDesc"/>

			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXPKit"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXPKit"/>

				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryRoyalJelly"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" target="other" buff="buffFoxacaryRoyalJelly"/>
				<display_value name="dHealthAmount" value="1"/>
				<display_value name="dDuration" value="60"/>
			</effect_group>
		</item>

		<!-- =============================================================== -->
		<!-- Foxacary Transfusion Kit                                          -->
		<!-- 70 HP at once, another 70 over 35 seconds, stops bleeding.       -->
		<!-- Uses: blood bags, duct tape, first aid bandage.                   -->
		<!-- =============================================================== -->
		<item name="foxacaryTransfusionKit">
			<property name="Extends" value="medicalFirstAidKit"/>
			<property name="CustomIcon" value="medicalFirstAidKit"/>
			<property name="CustomIconTint" value="ff5050"/>
			<property name="DisplayType" value="foxacaryTransfusion"/>
			<property name="Tags" value="medical,medicalSkill,foxacary"/>
			<property name="Group" value="Science,Medical,TCMedical"/>
			<property name="UnlockedBy" value="craftingMedical"/>
			<property name="EconomicValue" value="300"/>
			<property name="Stacknumber" value="3"/>
			<property name="DescriptionKey" value="foxacaryTransfusionKitDesc"/>

			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXPKit"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXPKit"/>

				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyStats" stat="Health" operation="add" value="70"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffInjuryBleeding"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryTransfusion"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="ModifyStats" stat="Health" operation="add" value="70" target="other"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="RemoveBuff" target="other" buff="buffInjuryBleeding"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" target="other" buff="buffFoxacaryTransfusion"/>
				<display_value name="dInstantHealth" value="70"/>
				<display_value name="dHealthAmount" value="2"/>
				<display_value name="dDuration" value="35"/>
				<display_value name="dStopsBleeding" value="1"/>
			</effect_group>
		</item>

		<!-- =============================================================== -->
		<!-- Foxacary Cold Compress                                           -->
		<!-- Eases a concussion for 35 minutes without curing it: the penalties -->
		<!-- are held off while it heals at its usual pace, so about four      -->
		<!-- compresses see out a full one. Painkillers stay the cure.         -->
		<!-- Cools you down in a Sand Storm: stops the storm's clock for 60    -->
		<!-- seconds (buffFoxacaryStormReliefDesert).                          -->
		<!-- Uses: snowballs (one vanilla recipe), cloth.                      -->
		<!-- =============================================================== -->
		<item name="foxacaryColdCompress">
			<property name="Extends" value="medicalBandage"/>
			<property name="CustomIcon" value="resourceSnowBall"/>
			<property name="CustomIconTint" value="c0e8ff"/>
			<property name="DisplayType" value="foxacaryColdCompress"/>
			<property name="Tags" value="medical,medicalSkill,foxacary"/>
			<property name="Group" value="Science,Medical,TCMedical"/>
			<property name="UnlockedBy" value="craftingMedical"/>
			<property name="EconomicValue" value="20"/>
			<property name="Stacknumber" value="5"/>
			<property name="DescriptionKey" value="foxacaryColdCompressDesc"/>

			<property class="Action0">
				<requirement name="HasBuff" buff="buffInjuryConcussion,buffDesert_Storm"/>
			</property>

			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP">
					<requirement name="HasBuff" target="other" buff="buffInjuryConcussion"/></triggered_effect>

				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryColdCompress">
					<requirement name="HasBuff" buff="buffInjuryConcussion"/></triggered_effect>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" target="other" buff="buffFoxacaryColdCompress">
					<requirement name="HasBuff" target="other" buff="buffInjuryConcussion"/></triggered_effect>
				<display_value name="dEasesConcussion" value="1"/>
				<display_value name="dDuration" value="2100"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryStormReliefDesert">
					<requirement name="HasBuff" buff="buffDesert_Storm"/></triggered_effect>
			</effect_group>
		</item>

		<!-- =============================================================== -->
		<!-- Foxacary Burn Salve                                              -->
		<!-- Puts out fire, heals 20 over 20 seconds, and stops an Ember      -->
		<!-- Storm's clock for 60 seconds (buffFoxacaryStormReliefBurnt).     -->
		<!-- Uses: aloe cream, animal fat, beeswax (one vanilla recipe).       -->
		<!-- =============================================================== -->
		<item name="foxacaryBurnSalve">
			<property name="Extends" value="medicalAloeCream"/>
			<property name="CustomIcon" value="medicalAloeCream"/>
			<property name="CustomIconTint" value="e07040"/>
			<property name="DisplayType" value="foxacaryHealOverTime"/>
			<property name="Tags" value="medical,medicalSkill,foxacary"/>
			<property name="Group" value="Science,Medical,TCMedical"/>
			<property name="UnlockedBy" value="craftingMedical"/>
			<property name="EconomicValue" value="60"/>
			<property name="Stacknumber" value="5"/>
			<property name="DescriptionKey" value="foxacaryBurnSalveDesc"/>

			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP"/>

				<triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffBurningElement,buffBurningMolotov,buffBurningZombie,buffBurningFlamingArrow,buffBurningEnvironment"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryBurnSalve"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="RemoveBuff" target="other" buff="buffBurningElement,buffBurningMolotov,buffBurningZombie,buffBurningFlamingArrow,buffBurningEnvironment"/>
				<triggered_effect trigger="onSelfSecondaryActionEnd" action="AddBuff" target="other" buff="buffFoxacaryBurnSalve"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryStormReliefBurnt">
					<requirement name="HasBuff" buff="buffBurnt_Storm"/></triggered_effect>
				<display_value name="dHealthAmount" value="1"/>
				<display_value name="dDuration" value="20"/>
			</effect_group>
		</item>

		<!-- =============================================================== -->
		<!-- Foxacary Adrenaline Shot                                         -->
		<!-- 30 seconds of +20% run speed and +50% stamina regen to get out   -->
		<!-- of trouble, then 60 seconds of -25% stamina regen as it wears off.-->
		<!-- Uses: testosterone extract (two vanilla recipes), painkillers.    -->
		<!-- =============================================================== -->
		<item name="foxacaryAdrenalineShot">
			<property name="Extends" value="drugSteroids"/>
			<property name="CustomIcon" value="drugSteroids"/>
			<property name="CustomIconTint" value="ffd040"/>
			<property name="DisplayType" value="foxacaryAdrenaline"/>
			<property name="Tags" value="medical,medicalSkill,foxacary"/>
			<property name="Group" value="Science,Medical,TCMedical"/>
			<property name="UnlockedBy" value="craftingMedical"/>
			<property name="EconomicValue" value="120"/>
			<property name="Stacknumber" value="5"/>
			<property name="DescriptionKey" value="foxacaryAdrenalineShotDesc"/>

			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP"/>

				<triggered_effect trigger="onSelfPrimaryActionEnd" action="RemoveBuff" buff="buffFoxacaryAdrenalineCrash"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryAdrenaline"/>
				<display_value name="dRunSpeed" value=".2"/>
				<display_value name="dDuration" value="30"/>
			</effect_group>
		</item>

		<!-- =============================================================== -->
		<!-- Foxacary Rad Shot                                                -->
		<!-- Stops a Radiation Storm's clock for 120 seconds                  -->
		<!-- (buffFoxacaryStormReliefWasteland) and heals 30 over 30 seconds. -->
		<!-- Doesn't touch the biome hazard timers (vanilla's smoothies do    -->
		<!-- that) or the deadly radiation at the map's edge.                 -->
		<!-- Uses: blood bag, nitrate powder, radiated mushrooms (one recipe). -->
		<!-- =============================================================== -->
		<item name="foxacaryRadShot">
			<property name="Extends" value="drugSteroids"/>
			<property name="CustomIcon" value="drugSteroids"/>
			<property name="CustomIconTint" value="80ff60"/>
			<property name="DisplayType" value="foxacaryHealOverTime"/>
			<property name="Tags" value="medical,medicalSkill,foxacary"/>
			<property name="Group" value="Science,Medical,TCMedical"/>
			<property name="UnlockedBy" value="craftingMedical"/>
			<property name="EconomicValue" value="200"/>
			<property name="Stacknumber" value="5"/>
			<property name="DescriptionKey" value="foxacaryRadShotDesc"/>

			<effect_group tiered="false">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryMedicalXP"/>

				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryRadShot"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffFoxacaryStormReliefWasteland">
					<requirement name="HasBuff" buff="buffWasteland_Storm"/></triggered_effect>
				<display_value name="dHealthAmount" value="1"/>
				<display_value name="dDuration" value="30"/>
			</effect_group>
		</item>

	</append>

</configs>

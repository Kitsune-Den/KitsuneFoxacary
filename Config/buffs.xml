<configs>

	<!-- ================================================================== -->
	<!-- Foxacary custom buffs                                                -->
	<!-- ================================================================== -->

	<append xpath="/buffs">

		<!-- =============================================================== -->
		<!-- buffFoxacaryRoyalJelly                                           -->
		<!-- Heal-over-time applied by the Royal Jelly Salve.                  -->
		<!-- 50 HP over 60 seconds at ~0.83 HP/s.                              -->
		<!-- =============================================================== -->
		<buff name="buffFoxacaryRoyalJelly" name_key="buffFoxacaryRoyalJellyName" description_key="buffFoxacaryRoyalJellyDesc" icon="ui_game_symbol_medical" icon_color="255,200,40">
			<stack_type value="replace"/>
			<duration value="60"/>
			<display_value value="duration"/>
			<update_rate value="1"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="add" value="1"/>
			</effect_group>
		</buff>

		<!-- =============================================================== -->
		<!-- buffFoxacaryHoneyedDressing                                      -->
		<!-- Short window of infection-catch resistance after application.     -->
		<!-- Player feels "I treated the wound" and is protected until the     -->
		<!-- dressing is effectively spent. The cure part is vanilla honey's   -->
		<!-- buffInfectionAddCure, applied by the item.                        -->
		<!-- =============================================================== -->
		<buff name="buffFoxacaryHoneyedDressing" name_key="buffFoxacaryHoneyedDressingName" description_key="buffFoxacaryHoneyedDressingDesc" icon="ui_game_symbol_infection_immunity" icon_color="240,180,40">
			<stack_type value="replace"/>
			<duration value="120"/>
			<display_value value="duration"/>

			<effect_group>
				<passive_effect name="BuffResistance" operation="base_add" value="1" tags="buffInfectionCatch"/>
			</effect_group>
		</buff>

		<!-- =============================================================== -->
		<!-- buffFoxacaryTransfusion                                          -->
		<!-- Applied by the Transfusion Kit after its instant 70 HP.          -->
		<!-- Another 70 HP over 35 seconds, 2 HP/s.                           -->
		<!-- =============================================================== -->
		<buff name="buffFoxacaryTransfusion" name_key="buffFoxacaryTransfusionName" description_key="buffFoxacaryTransfusionDesc" icon="ui_game_symbol_medical" icon_color="255,80,80">
			<stack_type value="replace"/>
			<duration value="35"/>
			<display_value value="duration"/>
			<update_rate value="1"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="add" value="2"/>
			</effect_group>
		</buff>

		<!-- =============================================================== -->
		<!-- buffFoxacaryBurnSalve: 20 HP over 20 seconds after a Burn Salve. -->
		<!-- =============================================================== -->
		<buff name="buffFoxacaryBurnSalve" name_key="buffFoxacaryBurnSalveName" description_key="buffFoxacaryBurnSalveDesc" icon="ui_game_symbol_medical" icon_color="230,120,60">
			<stack_type value="replace"/>
			<duration value="20"/>
			<display_value value="duration"/>
			<update_rate value="1"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="add" value="1"/>
			</effect_group>
		</buff>

		<!-- =============================================================== -->
		<!-- buffFoxacaryAdrenaline: 30 seconds of +20% run speed and +50%    -->
		<!-- stamina regen. When it ends, the crash starts.                   -->
		<!-- =============================================================== -->
		<buff name="buffFoxacaryAdrenaline" name_key="buffFoxacaryAdrenalineName" description_key="buffFoxacaryAdrenalineDesc" icon="ui_game_symbol_run" icon_color="255,210,60">
			<stack_type value="replace"/>
			<duration value="30"/>
			<display_value value="duration"/>

			<effect_group>
				<passive_effect name="RunSpeed" operation="perc_add" value=".2"/>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value=".5"/>
				<triggered_effect trigger="onSelfBuffFinish" action="AddBuff" buff="buffFoxacaryAdrenalineCrash"/>
			</effect_group>
		</buff>

		<!-- =============================================================== -->
		<!-- buffFoxacaryAdrenalineCrash: 60 seconds of -25% stamina regen.   -->
		<!-- =============================================================== -->
		<buff name="buffFoxacaryAdrenalineCrash" name_key="buffFoxacaryAdrenalineCrashName" description_key="buffFoxacaryAdrenalineCrashDesc" icon="ui_game_symbol_run" icon_color="140,140,140">
			<stack_type value="replace"/>
			<duration value="60"/>
			<display_value value="duration"/>

			<effect_group>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value="-.25"/>
			</effect_group>
		</buff>

		<!-- =============================================================== -->
		<!-- buffFoxacaryRadShot: 30 HP over 30 seconds after a Rad Shot.     -->
		<!-- =============================================================== -->
		<buff name="buffFoxacaryRadShot" name_key="buffFoxacaryRadShotName" description_key="buffFoxacaryRadShotDesc" icon="ui_game_symbol_medical" icon_color="120,255,90">
			<stack_type value="replace"/>
			<duration value="30"/>
			<display_value value="duration"/>
			<update_rate value="1"/>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyStats" stat="Health" operation="add" value="1"/>
			</effect_group>
		</buff>

		<!-- =============================================================== -->
		<!-- buffFoxacaryColdCompress: 35 minutes with a concussion's         -->
		<!-- penalties held off. The concussion stays and heals at its usual  -->
		<!-- pace (about 2 hours from a fresh one), so it takes about four    -->
		<!-- compresses to see one out. Another compress resets the clock to -->
		<!-- 35 minutes, it doesn't add to it. Gone with the concussion.      -->
		<!-- =============================================================== -->
		<buff name="buffFoxacaryColdCompress" name_key="buffFoxacaryColdCompressName" description_key="buffFoxacaryColdCompressDesc" icon="ui_game_symbol_cold" icon_color="190,230,255">
			<stack_type value="replace"/>
			<duration value="2100"/>
			<display_value value="duration"/>
			<update_rate value="1"/>

			<!-- Undo buffInjuryConcussion's penalties: -1 to every attribute, -->
			<!-- the max health it blocks, and the blur spells.                -->
			<effect_group>
				<requirement name="HasBuff" buff="buffInjuryConcussion"/>
				<passive_effect name="AttributeLevel" operation="base_add" value="1"/>
				<passive_effect name="HealthMaxBlockage" operation="base_subtract" value="@.ConcussionHealthBlockage"/>
				<passive_effect name="BuffResistance" operation="base_add" value="1" tags="buffInjuryConcussionBlur"/>
			</effect_group>

			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffFoxacaryColdCompress">
					<requirement name="!HasBuff" buff="buffInjuryConcussion"/></triggered_effect>
				<triggered_effect trigger="onSelfBuffStart" action="RefreshPerks"/>
				<triggered_effect trigger="onSelfBuffFinish" action="RefreshPerks"/>
				<triggered_effect trigger="onSelfBuffRemove" action="RefreshPerks"/>
			</effect_group>
		</buff>

	</append>

</configs>
